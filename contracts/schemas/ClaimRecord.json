{
  "$defs": {
    "AiSource": {
      "description": "Where a recommendation came from: the model, its saved answer, or a fixed rule (R22).",
      "enum": [
        "model",
        "fallback",
        "rule"
      ],
      "type": "string"
    },
    "AuditReason": {
      "description": "Why a person looks at an automated decision.",
      "oneOf": [
        {
          "const": "risk_review",
          "description": "Its anomaly score reached `risk_review_threshold`.",
          "type": "string"
        },
        {
          "const": "random_sample",
          "description": "Drawn in the random sample, `audit_sample_rate` of decisions (R14).",
          "type": "string"
        }
      ]
    },
    "Claim": {
      "properties": {
        "amount_claimed": {
          "$ref": "#/$defs/Money"
        },
        "asked_for_person": {
          "type": "boolean"
        },
        "circumstance": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_id": {
          "type": "string"
        },
        "class_of_business": {
          "type": "string"
        },
        "cover_id": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "evidence": {
          "description": "Registered evidence kinds sent so far.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "guarantee_requested": {
          "$ref": "#/$defs/Money"
        },
        "loss_date": {
          "format": "date",
          "type": "string"
        },
        "notified_at": {
          "format": "date-time",
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ClaimState"
        },
        "urgent": {
          "description": "Urgent by the rules or the AI's escalation (R46); never reset.",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "policy_id",
        "customer_id",
        "cover_id",
        "class_of_business",
        "loss_date",
        "notified_at",
        "amount_claimed",
        "asked_for_person",
        "guarantee_requested",
        "evidence",
        "urgent",
        "state"
      ],
      "type": "object"
    },
    "ClaimPayment": {
      "description": "A claim payment approved: cash first, then settlement in kind the cover's terms permit, that\nis suitable now and worth at least the cash (R16, R28). Posted once under its key (R27).",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "claim_id": {
          "type": "string"
        },
        "cover_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Settlement"
          },
          "type": "array"
        },
        "policy_id": {
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "claim_id",
        "policy_id",
        "cover_id",
        "amount",
        "options"
      ],
      "type": "object"
    },
    "ClaimReferral": {
      "description": "Why a claim is with a person.",
      "oneOf": [
        {
          "description": "No cover in force for the loss: outside the policy period, lapsed, not held or excluded.",
          "properties": {
            "referral": {
              "const": "not_in_force",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The loss fell in the cover's waiting period (R07) or a re-entry waiting period (R47).",
          "properties": {
            "referral": {
              "const": "waiting_period",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The assessor gave no assessment (R22).",
          "properties": {
            "referral": {
              "const": "no_assessment",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The assessor recommended a person look.",
          "properties": {
            "referral": {
              "const": "assessor_referred",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The assessor's confidence is below `stp_min_confidence`.",
          "properties": {
            "referral": {
              "const": "low_confidence",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The amount claimed exceeds the assessor's estimate by more than `estimate_tolerance`.",
          "properties": {
            "referral": {
              "const": "above_estimate",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The claim payment would exceed the STP limit.",
          "properties": {
            "referral": {
              "const": "above_stp_limit",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "Drawn for audit, or at the risk review threshold, before payment (R14).",
          "properties": {
            "reason": {
              "$ref": "#/$defs/AuditReason"
            },
            "referral": {
              "const": "audit",
              "type": "string"
            }
          },
          "required": [
            "referral",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The customer asked for a person, or needs human care (R46).",
          "properties": {
            "referral": {
              "const": "human_care",
              "type": "string"
            }
          },
          "required": [
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "The customer asked for a decline to be reviewed: a different person decides (R15).",
          "properties": {
            "declined_by": {
              "type": "string"
            },
            "referral": {
              "const": "appeal",
              "type": "string"
            }
          },
          "required": [
            "referral",
            "declined_by"
          ],
          "type": "object"
        }
      ]
    },
    "ClaimState": {
      "oneOf": [
        {
          "description": "Waiting for evidence the cover asks for.",
          "properties": {
            "missing": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "state": {
              "const": "awaiting_evidence",
              "type": "string"
            }
          },
          "required": [
            "state",
            "missing"
          ],
          "type": "object"
        },
        {
          "description": "Evidence complete: with the assessor, then `decide`.",
          "properties": {
            "state": {
              "const": "assessing",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "due": {
              "description": "A person decides by then: `referral_sla_hours`, or `appeal_sla_hours` on review.",
              "format": "date-time",
              "type": "string"
            },
            "referral": {
              "$ref": "#/$defs/ClaimReferral"
            },
            "since": {
              "format": "date-time",
              "type": "string"
            },
            "state": {
              "const": "with_person",
              "type": "string"
            }
          },
          "required": [
            "state",
            "since",
            "due",
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "A claim payment was issued for `amount`.",
          "properties": {
            "amount": {
              "$ref": "#/$defs/Money"
            },
            "by": {
              "$ref": "#/$defs/DecidedBy"
            },
            "on": {
              "format": "date-time",
              "type": "string"
            },
            "state": {
              "const": "approved",
              "type": "string"
            }
          },
          "required": [
            "state",
            "by",
            "on",
            "amount"
          ],
          "type": "object"
        },
        {
          "description": "Only a person declines (R13).",
          "properties": {
            "on": {
              "format": "date-time",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/DeclineReason"
            },
            "reviewer": {
              "type": "string"
            },
            "state": {
              "const": "declined",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reviewer",
            "on",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "DecidedBy": {
      "oneOf": [
        {
          "enum": [
            "person"
          ],
          "type": "string"
        },
        {
          "const": "stp",
          "description": "Straight through, on the assessor's recommendation and the rules.",
          "type": "string"
        }
      ]
    },
    "DeclineReason": {
      "description": "Why a person declined a claim. A closed set, each tied to the policy wording; the customer is\ntold the reason and that they can ask for a review (R15).",
      "oneOf": [
        {
          "enum": [
            "not_in_force",
            "waiting_period",
            "not_an_insured_loss",
            "policy_exclusion",
            "evidence_not_provided"
          ],
          "type": "string"
        },
        {
          "const": "fraud",
          "description": "Fraud, which only a person finds (R10, R13).",
          "type": "string"
        }
      ]
    },
    "FirstAction": {
      "description": "What the first response does (`guardrails.human_care.first_response`). A closed set: each is\ncarried out by the assistance channel.",
      "oneOf": [
        {
          "const": "emergency_numbers",
          "description": "Local emergency numbers, shown at once.",
          "type": "string"
        },
        {
          "const": "assistance_provider_connect",
          "description": "A call or chat with the assistance provider, opened at once.",
          "type": "string"
        },
        {
          "const": "guarantee_of_payment",
          "description": "A guarantee of payment to the hospital or provider, automatic up to the cap.",
          "type": "string"
        }
      ]
    },
    "FirstResponse": {
      "description": "The automatic first response to an urgent case.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/FirstAction"
          },
          "type": "array"
        },
        "guarantee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Guarantee"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when no guarantee was asked for, or no cover in the class is active."
        },
        "respond_by": {
          "description": "Sent by then: `urgent_response_seconds` after notification.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "respond_by",
        "actions"
      ],
      "type": "object"
    },
    "Guarantee": {
      "description": "A guarantee of payment: automatic up to `auto_guarantee_cap`, the rest only once the\nassistance provider confirms.",
      "properties": {
        "automatic": {
          "$ref": "#/$defs/Money"
        },
        "to_confirm": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "automatic",
        "to_confirm"
      ],
      "type": "object"
    },
    "Money": {
      "description": "Money in minor units (cents). No floating point in money paths (R29).",
      "format": "int64",
      "type": "integer"
    },
    "PersonRoute": {
      "description": "Whether and how a person comes in.",
      "oneOf": [
        {
          "const": "not_needed",
          "description": "The usual path; the customer can still ask for a person at any time.",
          "type": "string"
        },
        {
          "const": "offered",
          "description": "After the first response a person is offered; the customer chooses.",
          "type": "string"
        },
        {
          "const": "assigned",
          "description": "A person takes the case: the customer asked, or needs human care.",
          "type": "string"
        }
      ]
    },
    "Settled": {
      "description": "How a payout was settled.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "cash": {
          "$ref": "#/$defs/Money",
          "description": "Paid to the customer; zero when settled in kind."
        },
        "idempotency_key": {
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/Settlement"
        },
        "premium_set_off": {
          "$ref": "#/$defs/Money",
          "description": "Premium due set off against a cash payout in the grace period (R53)."
        }
      },
      "required": [
        "idempotency_key",
        "method",
        "amount",
        "premium_set_off",
        "cash"
      ],
      "type": "object"
    },
    "Settlement": {
      "oneOf": [
        {
          "properties": {
            "method": {
              "const": "cash",
              "type": "string"
            }
          },
          "required": [
            "method"
          ],
          "type": "object"
        },
        {
          "description": "A registered alternative the cover's terms permit, such as `lounge_access`.",
          "properties": {
            "method": {
              "const": "in_kind",
              "type": "string"
            },
            "option": {
              "type": "string"
            }
          },
          "required": [
            "method",
            "option"
          ],
          "type": "object"
        }
      ]
    },
    "Triage": {
      "properties": {
        "first_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirstResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "person": {
          "$ref": "#/$defs/PersonRoute"
        },
        "urgent": {
          "description": "Empty when the case is not urgent.",
          "items": {
            "$ref": "#/$defs/UrgentBecause"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "urgent",
        "person"
      ],
      "type": "object"
    },
    "UrgentBecause": {
      "description": "Why a case is urgent.",
      "oneOf": [
        {
          "description": "The customer reported a configured urgent circumstance, such as `injury`.",
          "properties": {
            "because": {
              "const": "circumstance",
              "type": "string"
            },
            "circumstance": {
              "type": "string"
            }
          },
          "required": [
            "because",
            "circumstance"
          ],
          "type": "object"
        },
        {
          "description": "The loss is at least `large_loss_share_of_monthly_income` of the customer's monthly\nearnings.",
          "properties": {
            "because": {
              "const": "large_loss",
              "type": "string"
            }
          },
          "required": [
            "because"
          ],
          "type": "object"
        },
        {
          "description": "The AI layer marked it urgent.",
          "properties": {
            "because": {
              "const": "ai_escalated",
              "type": "string"
            }
          },
          "required": [
            "because"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A claim as the store keeps it and the customer sees it.",
  "properties": {
    "assessed_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/AiSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim": {
      "$ref": "#/$defs/Claim"
    },
    "description": {
      "type": "string"
    },
    "evidence": {
      "description": "Evidence fingerprints received.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "guarantee_reference": {
      "description": "The guarantee above the automatic cap, sent to the assistance provider to confirm.",
      "type": [
        "string",
        "null"
      ]
    },
    "payment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimPayment"
        },
        {
          "type": "null"
        }
      ]
    },
    "settled": {
      "anyOf": [
        {
          "$ref": "#/$defs/Settled"
        },
        {
          "type": "null"
        }
      ]
    },
    "triage": {
      "$ref": "#/$defs/Triage",
      "description": "The triage when notified, with any first response (R46)."
    }
  },
  "required": [
    "claim",
    "description",
    "triage",
    "evidence"
  ],
  "title": "ClaimRecord",
  "type": "object"
}
