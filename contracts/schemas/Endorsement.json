{
  "$defs": {
    "Allocation": {
      "properties": {
        "cover_id": {
          "type": "string"
        },
        "premium": {
          "$ref": "#/$defs/Money",
          "description": "Share of the plan price."
        },
        "sum_insured": {
          "$ref": "#/$defs/Money",
          "description": "Sum insured (indemnity) or benefit amount per trigger event (parametric) this premium buys."
        }
      },
      "required": [
        "cover_id",
        "premium",
        "sum_insured"
      ],
      "type": "object"
    },
    "Money": {
      "description": "Money in minor units (cents). No floating point in money paths (R29).",
      "format": "int64",
      "type": "integer"
    },
    "OfferKind": {
      "oneOf": [
        {
          "description": "New business: a first schedule, bound through `partner_id` or, with none, the insurer's\nown journey (R52, R58).",
          "properties": {
            "kind": {
              "const": "new_policy",
              "type": "string"
            },
            "partner_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "schedule": {
              "$ref": "#/$defs/Schedule"
            }
          },
          "required": [
            "kind",
            "schedule"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "reallocation",
              "type": "string"
            },
            "schedule": {
              "$ref": "#/$defs/Schedule"
            }
          },
          "required": [
            "kind",
            "schedule"
          ],
          "type": "object"
        },
        {
          "description": "Only ever the customer's own choice of plan (R45).",
          "properties": {
            "kind": {
              "const": "plan_change",
              "type": "string"
            },
            "plan": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "plan"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cover_id": {
              "type": "string"
            },
            "kind": {
              "const": "add_cover",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cover_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cover_id": {
              "type": "string"
            },
            "kind": {
              "const": "remove_cover",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cover_id"
          ],
          "type": "object"
        }
      ]
    },
    "Schedule": {
      "description": "The covers and sums insured for one policy period. Allocations are ordered by cover id.",
      "properties": {
        "allocations": {
          "items": {
            "$ref": "#/$defs/Allocation"
          },
          "type": "array"
        },
        "plan_id": {
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "allocations"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An accepted change, effective from the next policy period (R04).",
  "properties": {
    "change": {
      "$ref": "#/$defs/OfferKind"
    },
    "effective_period": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "policy_id": {
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "effective_period",
    "change"
  ],
  "title": "Endorsement",
  "type": "object"
}
