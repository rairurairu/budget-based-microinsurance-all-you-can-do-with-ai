{
  "$defs": {
    "AiSource": {
      "description": "Where a recommendation came from: the model, its saved answer, or a fixed rule (R22).",
      "enum": [
        "model",
        "fallback",
        "rule"
      ],
      "type": "string"
    },
    "EarnedFor": {
      "description": "What a reward can be earned for. A closed type with no claim-free variant: no reward is ever\nconditional on not claiming (R26).",
      "oneOf": [
        {
          "description": "A verified prevention activity (R10, R40).",
          "properties": {
            "for": {
              "const": "verified_activity",
              "type": "string"
            },
            "task_id": {
              "type": "string"
            }
          },
          "required": [
            "for",
            "task_id"
          ],
          "type": "object"
        },
        {
          "description": "Verified activity in this many consecutive policy periods in one points pool (R26).",
          "properties": {
            "for": {
              "const": "participation_streak",
              "type": "string"
            },
            "periods": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "for",
            "periods"
          ],
          "type": "object"
        }
      ]
    },
    "Funder": {
      "enum": [
        "insurer",
        "partner",
        "co_funded"
      ],
      "type": "string"
    },
    "Grant": {
      "description": "A reward granted into the customer's reward balance: the amount earned, reduced to the room\nleft under the monthly cap (R17).",
      "properties": {
        "granted": {
          "$ref": "#/$defs/Money"
        },
        "idempotency_key": {
          "type": "string"
        },
        "over_cap": {
          "$ref": "#/$defs/Money",
          "description": "Earned but over the monthly cap; the customer is told."
        },
        "reward": {
          "$ref": "#/$defs/RewardEarned"
        }
      },
      "required": [
        "idempotency_key",
        "reward",
        "granted",
        "over_cap"
      ],
      "type": "object"
    },
    "Money": {
      "description": "Money in minor units (cents). No floating point in money paths (R29).",
      "format": "int64",
      "type": "integer"
    },
    "RewardEarned": {
      "description": "A reward earned, before the monthly cap.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "customer_id": {
          "type": "string"
        },
        "earned_for": {
          "$ref": "#/$defs/EarnedFor"
        },
        "on": {
          "description": "Market local date.",
          "format": "date",
          "type": "string"
        },
        "pool": {
          "description": "The points pool of the behaviour it rewards (R36).",
          "type": "string"
        },
        "reward_id": {
          "type": "string"
        }
      },
      "required": [
        "reward_id",
        "customer_id",
        "pool",
        "earned_for",
        "amount",
        "on"
      ],
      "type": "object"
    },
    "RewardOffer": {
      "description": "A way to spend the reward balance: cash, or a partner reward from a registered supplier.",
      "properties": {
        "description": {
          "description": "The partner's own words; the app shows cash in the customer's language.",
          "type": "string"
        },
        "family": {
          "description": "A configured reward family (`rewards.families`); `cash` for the cash offer.",
          "type": "string"
        },
        "funded_by": {
          "$ref": "#/$defs/Funder",
          "description": "Who funds the value above the price."
        },
        "inventory": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "is_cash": {
          "type": "boolean"
        },
        "offer_id": {
          "type": "string"
        },
        "partner_id": {
          "description": "The supplier that delivers it (`config/suppliers.yaml`); none for cash.",
          "type": [
            "string",
            "null"
          ]
        },
        "perceived_value": {
          "$ref": "#/$defs/Money",
          "description": "What the customer sees."
        },
        "price": {
          "$ref": "#/$defs/Money",
          "description": "Taken from the reward balance: what the insurer pays the supplier when it is delivered.\nThe supplier's spare capacity funds the value above it."
        }
      },
      "required": [
        "offer_id",
        "family",
        "description",
        "perceived_value",
        "price",
        "funded_by",
        "is_cash"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The reward balance and how it can be spent: cash for all of it first, always (R16).",
  "properties": {
    "balance": {
      "$ref": "#/$defs/Money"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/Grant"
      },
      "type": "array"
    },
    "menu": {
      "description": "In the order shown: cash first, then partner rewards as ranked.",
      "items": {
        "$ref": "#/$defs/RewardOffer"
      },
      "type": "array"
    },
    "ranked_by": {
      "$ref": "#/$defs/AiSource"
    }
  },
  "required": [
    "balance",
    "menu",
    "ranked_by",
    "grants"
  ],
  "title": "RewardsView",
  "type": "object"
}
