{
  "$defs": {
    "AuditReason": {
      "description": "Why a person looks at an automated decision.",
      "oneOf": [
        {
          "const": "risk_review",
          "description": "Its anomaly score reached `risk_review_threshold`.",
          "type": "string"
        },
        {
          "const": "random_sample",
          "description": "Drawn in the random sample, `audit_sample_rate` of decisions (R14).",
          "type": "string"
        }
      ]
    },
    "Bps": {
      "description": "A ratio in basis points: 10,000 = 100%.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "Money": {
      "description": "Money in minor units (cents). No floating point in money paths (R29).",
      "format": "int64",
      "type": "integer"
    },
    "PreventionTask": {
      "description": "One prevention task offered to one customer.",
      "properties": {
        "class_of_business": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/PreventionTaskDraft"
        },
        "due": {
          "description": "Last day evidence can be sent: the event's start, or the policy period's last day.",
          "format": "date",
          "type": "string"
        },
        "offered_on": {
          "format": "date",
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "customer_id",
        "policy_id",
        "class_of_business",
        "draft",
        "offered_on",
        "due",
        "state"
      ],
      "type": "object"
    },
    "PreventionTaskDraft": {
      "properties": {
        "action": {
          "description": "What the customer does, in one sentence.",
          "type": "string"
        },
        "avg_claim_cost": {
          "$ref": "#/$defs/Money",
          "description": "Average claim cost in the class, at most the customer's sum insured (R48)."
        },
        "claim_prob_after": {
          "$ref": "#/$defs/Bps"
        },
        "claim_prob_before": {
          "$ref": "#/$defs/Bps",
          "description": "This customer's claim probability per policy period without and with the action (R40)."
        },
        "cover_id": {
          "type": "string"
        },
        "event_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "description": "A registered evidence kind (`config/data_types.yaml`).",
          "type": "string"
        },
        "reward_cost": {
          "$ref": "#/$defs/Money"
        },
        "task_type": {
          "description": "A registered loss prevention measure (`config/prevention_measures.yaml`).",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "cover_id",
        "action",
        "evidence",
        "claim_prob_before",
        "claim_prob_after",
        "avg_claim_cost",
        "reward_cost"
      ],
      "type": "object"
    },
    "Referral": {
      "description": "Why a task is with a person.",
      "oneOf": [
        {
          "const": "no_verdict",
          "description": "The verifier gave no verdict (R22).",
          "type": "string"
        },
        {
          "const": "suspected_reuse",
          "description": "The evidence looks reused or edited: only a person decides fraud (R13).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A pass drawn for audit before it is credited (R14).",
          "properties": {
            "audit": {
              "$ref": "#/$defs/AuditReason"
            }
          },
          "required": [
            "audit"
          ],
          "type": "object"
        },
        {
          "const": "appeal",
          "description": "The customer asked a person to look again (R15).",
          "type": "string"
        }
      ]
    },
    "TaskState": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "offered",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The customer tapped to take it on.",
          "properties": {
            "on": {
              "format": "date",
              "type": "string"
            },
            "state": {
              "const": "accepted",
              "type": "string"
            }
          },
          "required": [
            "state",
            "on"
          ],
          "type": "object"
        },
        {
          "description": "Evidence sent, by fingerprint.",
          "properties": {
            "evidence": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "on": {
              "format": "date",
              "type": "string"
            },
            "state": {
              "const": "submitted",
              "type": "string"
            }
          },
          "required": [
            "state",
            "on",
            "evidence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "on": {
              "format": "date",
              "type": "string"
            },
            "referral": {
              "$ref": "#/$defs/Referral"
            },
            "state": {
              "const": "with_person",
              "type": "string"
            }
          },
          "required": [
            "state",
            "on",
            "referral"
          ],
          "type": "object"
        },
        {
          "description": "Points and the reward are credited (R10).",
          "properties": {
            "by": {
              "$ref": "#/$defs/VerifiedBy"
            },
            "on": {
              "format": "date",
              "type": "string"
            },
            "state": {
              "const": "verified",
              "type": "string"
            }
          },
          "required": [
            "state",
            "on",
            "by"
          ],
          "type": "object"
        },
        {
          "description": "Can be sent again before the due date, or appealed (R15).",
          "properties": {
            "on": {
              "format": "date",
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "state": {
              "const": "not_verified",
              "type": "string"
            }
          },
          "required": [
            "state",
            "on",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "Not sent by the due date.",
          "properties": {
            "on": {
              "format": "date",
              "type": "string"
            },
            "state": {
              "const": "expired",
              "type": "string"
            }
          },
          "required": [
            "state",
            "on"
          ],
          "type": "object"
        }
      ]
    },
    "VerifiedBy": {
      "enum": [
        "verifier",
        "person"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A prevention task as the store keeps it.",
  "properties": {
    "task": {
      "$ref": "#/$defs/PreventionTask"
    },
    "with_person_since": {
      "description": "When it went to a person, for the work queue's service level.",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "task"
  ],
  "title": "TaskRecord",
  "type": "object"
}
